# -----------------------------------------------------------------------------
# App - Don't add "/" in the end of the url (same in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AI Logo Generation
# -----------------------------------------------------------------------------
# Option 1: OpenRouter (nano-banana-pro or similar model)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nano-banana-pro

# Option 2: inference.sh
INFERENCE_SH_API_KEY=
INFERENCE_SH_URL=https://queue.inference-dog.workers.dev/api/generate

# Which AI provider to use: "openrouter" or "inference"
AI_PROVIDER=openrouter

# -----------------------------------------------------------------------------
# Authentication (betterAuth)
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL='postgres://[user]:[password]@[host]:[port]/[dbname]'

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
FROM_EMAIL=noreply@yourapp.com
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Stripe (Payments)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Pricing tiers
FREE_GENERATIONS=5
PAID_GENERATIONS_PER_MONTH=50
SUBSCRIPTION_PRICE_USD=20
