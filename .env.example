# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public URL of the app (no trailing slash). Used for metadata and auth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database — Turso libSQL (SQLite-compatible)
# -----------------------------------------------------------------------------
# Local development uses a SQLite file; production uses Turso.
#   Local:     DATABASE_URL="file:./prisma/dev.db"
#   Turso:     DATABASE_URL="libsql://<your-db>.turso.io"
# Create a Turso DB:  turso db create my-app
# Get the URL:        turso db show my-app --url
# Get a token:        turso db tokens create my-app
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""

# -----------------------------------------------------------------------------
# Authentication (better-auth)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra trusted origins (e.g. preview URLs)
BETTER_AUTH_TRUSTED_ORIGINS=

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend) — optional; emails are skipped when the key is absent
# -----------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
# Optional local-only 6-digit code for email OTP sign-in testing (ignored in production)
EMAIL_OTP_TEST_CODE=123456
# Require email verification before sign-in (default: false)
REQUIRE_EMAIL_VERIFICATION=false
